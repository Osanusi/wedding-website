# Copy this file to `.env.local` and fill in values from your Supabase project.
# `.env.local` is git-ignored — never commit real keys.

# Supabase project URL (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon/public key (Project Settings → API → anon public)
# Safe to ship to the browser ONLY when paired with Row-Level Security policies.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cash registry payment links
VITE_PAYPAL_ME_URL=https://paypal.me/YOURHANDLE
VITE_VENMO_URL=https://venmo.com/u/YOURHANDLE
